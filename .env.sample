# =============================================================================
# Server設定
# =============================================================================
SERVER_PORT=8080
SERVER_MODE=debug
SERVER_GRACEFUL_SHUTDOWN_TIMEOUT=30s

# =============================================================================
# Database設定 (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sake_hack_app
DB_USER=postgres
DB_PASSWORD=sakehacksakehack
DB_SSL_MODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m

# =============================================================================
# Cache設定 (Valkey)
# =============================================================================
CACHE_HOST=localhost
CACHE_PORT=6379
CACHE_PASSWORD=sakehacksakehack
CACHE_DATABASE=0
CACHE_POOL_SIZE=10
CACHE_MIN_IDLE_CONNS=5
CACHE_MAX_RETRIES=3
CACHE_DIAL_TIMEOUT=5s
CACHE_READ_TIMEOUT=3s
CACHE_WRITE_TIMEOUT=3s

# =============================================================================
# JWT設定
# =============================================================================
JWT_SECRET=your-secret-key-change-me-in-production
JWT_EXPIRATION=86400
JWT_COOKIE_SECURE=false
JWT_COOKIE_NAME=sake_hack_token
JWT_COOKIE_PATH=/
JWT_COOKIE_DOMAIN=

# =============================================================================
# CORS設定
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Origin,Content-Type,Accept,Authorization
CORS_EXPOSED_HEADERS=Content-Length
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=43200

# =============================================================================
# Storage設定 (S3/RustFS)
# =============================================================================
STORAGE_BUCKET_NAME=sake-hack-bucket
STORAGE_REGION=ap-northeast-1
# ローカルの場合は指定，S3の場合は空欄に設定
STORAGE_ENDPOINT=http://localhost:9000
# RustFSを使用する場合はtrueに設定，S3を使用する場合は空欄に設定
STORAGE_ACCESS_KEY=rustfsadmin
# RustFSを使用する場合はtrueに設定，S3を使用する場合は空欄に設定
STORAGE_SECRET_KEY=rustfsadmin
# RustFSを使用する場合はtrueに設定，S3を使用する場合はfalseに設定
STORAGE_USE_PATH_STYLE=true
# 署名付きアップロードURLの有効期限(デフォルト: 15分)
STORAGE_UPLOAD_EXPIRY=15m
# 署名付きダウンロードURLの有効期限(デフォルト: 1時間)
STORAGE_DOWNLOAD_EXPIRY=1h

# =============================================================================
# Logging設定
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=console
